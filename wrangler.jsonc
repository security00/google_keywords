{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "google-keywords",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "google-keywords"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "BENCHMARK_KEYWORD": "gpts",
    "NEXT_PUBLIC_BENCHMARK_KEYWORD": "gpts",
    "CACHE_EXPIRY_HOURS": "24",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENROUTER_MODEL": "openai/gpt-5.2",
    "OPENROUTER_FILTER_TERMS": "赌博,博彩,赌场,投注,链接,新闻,名人,电影",
    "OPENROUTER_SITE_URL": "",
    "OPENROUTER_APP_NAME": "keyword-research",
    "NEXT_PUBLIC_FILTER_TERMS": "gambling,betting,casino,news,celebrity,movie,film,lottery,博彩,赌博,赌场,投注,新闻,名人,电影",
    "DEBUG_API_LOGS": "true",
    "RESEARCH_STATUS_GET_EXECUTION_COMPAT": "true",
    "BYOK_PROVIDER_CONNECTIONS_ENABLED": "false",
    "BYOK_PROVIDER_CONNECTIONS_ALLOWLIST": "",
    "BYOK_ACTIVE_KEK_VERSION": "v1",
    "BYOK_KEK_READ_VERSIONS": "v1",
    "BYOK_ACTIVE_FINGERPRINT_KEY_VERSION": "v1",
    "BYOK_FINGERPRINT_KEY_READ_VERSIONS": "v1",
    "SERP_LOCATION_NAME": "United States",
    "SERP_LANGUAGE_CODE": "en",
    "SERP_DEVICE": "desktop",
    "SERP_OS": "windows",
    "SERP_DEPTH": "10",
    "NEXT_PUBLIC_APP_URL": "https://www.discoverkeywords.co",
    "APP_URL": "https://www.discoverkeywords.co",
    "D1_DATABASE_NAME": "ai-trends"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-trends",
      "database_id": "b40de8a4-75e1-4df6-a84d-3ecd62b70538"
    }
  ]
}
