{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "node scripts/generate-cloudflare-types.mjs",
    "check:audit": "npm audit --audit-level=high",
    "check:cf-types": "node scripts/generate-cloudflare-types.mjs --check",
    "check:migrations": "node scripts/schema/check-d1-migrations.mjs",
    "check:student-paid-guards": "node scripts/run-python.mjs scripts/check_student_paid_guards.py",
    "check:byok-isolation": "node scripts/run-python.mjs scripts/check_byok_isolation.py",
    "check:staging-isolation": "node scripts/check-staging-isolation.mjs",
    "bootstrap:staging-d1": "node scripts/schema/bootstrap-staging-d1.mjs",
    "stage:staging-byok-keyring": "node scripts/byok/stage-staging-keyring.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:public-signup": "node scripts/smoke-public-signup.mjs && vitest run app/api/auth/sign-up/route.test.ts",
    "retain:production-assets": "node scripts/retain-production-static-assets.mjs",
    "test": "vitest run",
    "test:python": "node scripts/run-python.mjs -m unittest discover tests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.563.0",
    "next": "^16.4.6",
    "pg": "^8.17.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.8.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.4.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.6",
    "@opennextjs/cloudflare": "^1.20.19",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.2",
    "wrangler": "^4.168.0",
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "overrides": {
    "brace-expansion": "5.1.0",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.33",
    "sharp": "0.35.5"
  }
}
